# Janhit Hospital (जनहित हॉस्पिटल) - Frontend Environment Configuration
# Copy this file to .env or .env.production

# Backend REST API Base URL
# In development with Vite proxy: leave blank or set to /api
# In production with separate backend: set to full backend URL (e.g., https://api.janhithospital.com/api)
VITE_API_URL=http://localhost:5000/api

# Hospital Public Domain (for SEO canonical links, Open Graph & Sitemap generation)
VITE_SITE_URL=https://www.janhithospital.com

# Analytics & Monitoring (Optional)
# VITE_GA_TRACKING_ID=G-XXXXXXXXXX

